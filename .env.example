# Copy this file to .env and fill in your real key. .env is git-ignored.

# DeepSeek API key (get one at https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek exposes an OpenAI-compatible API at this base URL - shouldn't need
# to change unless DeepSeek's endpoint changes.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Which DeepSeek model to use for all agents.
DEEPSEEK_MODEL=deepseek-chat
